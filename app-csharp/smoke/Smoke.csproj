<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 0 interop smoke. net8.0 console (cross-platform, also runs in Linux CI)
    now built on the shared ContourCam.Interop library so the single interop
    layer is exercised by the existing CI smoke + M4 parity gate.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ContourCam.Smoke</RootNamespace>
    <AssemblyName>contourcam-smoke</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../interop/ContourCam.Interop.csproj" />
  </ItemGroup>

</Project>
